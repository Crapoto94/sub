# =============================================================================
# Subventions — configuration commune (docker-compose)
# Copier ce fichier vers .env et renseigner les valeurs.
# =============================================================================

# URL de l'API exposée au frontend (au build du frontend)
APP_API_URL=http://localhost:3261

# --- Application ---
JWT_SECRET=changez-moi
INITIAL_ADMIN_LOGIN=            # login Ville (AD) qui recevra le rôle admin au 1er login
LOCAL_ADMIN_USERNAME=           # compte local admin créé au démarrage (sans AD/APM)
LOCAL_ADMIN_PASSWORD=           # mot de passe du compte local admin (min. 8 caractères)
AUTH_MODE=apm                   # apm = authentification Active Directory via l'APM (production)
                                # local = dev sans APM (tout login est accepté)
CORS_ORIGINS=http://localhost:3260

# --- API centrale APM (services transverses : AD, mail, SMS...) ---
APM_API_URL=https://api.ivry.local
APM_API_KEY=                    # clé X-API-KEY fournie par l'admin APM (permission ad_auth)

# --- API métier Hub DSI (données Ville) ---
HUBDSI_API_URL=                 # https://dsihub.ivry.local
HUBDSI_API_KEY=                 # clé dsk_...
