# --- Application ---
PORT=3261
NODE_ENV=development
DB_FILE=./data/sub.sqlite
JWT_SECRET=changez-moi
JWT_EXPIRES_IN=8h
INITIAL_ADMIN_LOGIN=            # login Ville (AD) qui reçoit le rôle admin au 1er login
LOCAL_ADMIN_USERNAME=           # compte local admin créé au démarrage (sans AD/APM)
LOCAL_ADMIN_PASSWORD=           # mot de passe du compte local admin (min. 8 caractères)
AUTH_MODE=apm                   # apm = AD via l'APM (production) | local = dev sans APM
CORS_ORIGINS=http://localhost:3260

# --- API centrale APM (services transverses) ---
APM_API_URL=https://api.ivry.local
APM_API_KEY=                    # clé X-API-KEY (permission ad_auth) — à demander à l'admin APM

# --- API métier Hub DSI (données Ville) ---
HUBDSI_API_URL=                 # https://dsihub.ivry.local
HUBDSI_API_KEY=                 # clé dsk_...
